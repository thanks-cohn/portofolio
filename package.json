{
  "name": "nume-gallery",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "nume-vcatalog": "./bin/nume-vcatalog.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "truth:generate": "node scripts/generate-truth-safe.mjs",
    "dev": "npm run truth:generate && NEXT_PUBLIC_NUME_TARGET=local WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run build:cloudflare",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:vendor-catalogs": "node bin/nume-vcatalog.mjs validate --all --json",
    "typecheck": "rm -rf .next && tsc --noEmit",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "build:cloudflare": "npm run truth:generate && npm run validate:catalog && npm run validate:targets && bash scripts/build-verified.sh && npm run validate:targets",
    "build:pages": "npm run truth:generate && rm -rf out .next && NUME_BUILD_TARGET=github-pages NEXT_PUBLIC_NUME_TARGET=github-pages npx --no-install next build && npm run validate:targets",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy dist/server/index.js --assets dist/client",
    "validate:targets": "node scripts/validate-targets.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "NUME"
}
